MONGODB_URI=mongodb://localhost:27017/my_store_ai
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK (Service Account) — prefixo FIREBASE_ é reservado pelo Firebase Functions
ADMIN_PROJECT_ID=your-project-id
ADMIN_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Storage — nome do bucket (ex: my-project.firebasestorage.app)
STORAGE_BUCKET=your-project.firebasestorage.app
